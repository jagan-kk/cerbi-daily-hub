      "window-foreground": "oklch(0.96 0.01 240)",
      "window-bar": "oklch(0.42 0.14 280)",
      "window-bar-foreground": "oklch(0.99 0.01 240)",
      "card": "oklch(0.22 0.04 260)",
      "card-foreground": "oklch(0.96 0.01 240)",
      "primary": "oklch(0.78 0.19 320)",
      "primary-foreground": "oklch(0.14 0.03 260)",
      "secondary": "oklch(0.32 0.05 260)",
      "secondary-foreground": "oklch(0.96 0.01 240)",
      "muted": "oklch(0.30 0.03 260)",
      "muted-foreground": "oklch(0.75 0.03 260)",
      "accent": "oklch(0.85 0.17 90)",
