      "destructive": "oklch(0.62 0.22 25)",
      "destructive-foreground": "oklch(0.98 0.01 240)",
      "border": "oklch(0.14 0.03 260)",
      "input": "oklch(0.28 0.04 260)",
      "ring": "oklch(0.78 0.19 320)"
