    "bevel": {
      "outer-border": "oklch(0.08 0.02 260)",
      "inset-highlight": "oklch(0.35 0.06 280)",
      "inset-shadow": "oklch(0.15 0.03 260)",
      "drop-shadow": "oklch(0 0 0 / 0.6)"
    }
  },
  "typography": {
    "display": "'Press Start 2P', system-ui, monospace",
    "body": "'VT323', 'Courier New', monospace",
    "scale": {
      "micro": "9px",
      "small": "10px",
      "label": "11px",
      "body": "18px",
      "heading": "20px",
      "display": "24px",
      "giant": "48px"
    },
    "lineHeight": { "display": 1.4, "body": 1.6 },
    "letterSpacing": { "display": "0.02em", "body": "0" },
    "fontSmoothing": "none",
    "imageRendering": "pixelated"
  },
  "spacing": { "base": "4px", "units": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px" } },
  "border": { "width": "3px", "radius": "0" },
  "motion": {
    "duration-fast": "60ms",
    "duration-normal": "80ms",
    "easing-pixel": "steps(4)",
    "animations": ["pixel-pulse", "pixel-blink"]
  },
  "components": ["pixel-window", "pixel-btn", "pixel-input", "pixel-card", "pixel-tile", "pixel-badge"],
  "wallpapers": ["wp-grid-teal", "wp-grid-purple", "wp-stars", "wp-dungeon", "wp-sunset"],
  "accessibility": {
    "contrast": "4.5:1 minimum",
    "focusRing": "2px solid var(--color-ring), outline-offset 2px",
    "touchTarget": "44x44px minimum",
    "reducedMotion": "disabled pulse/blink, instant state"
  },
  "banned": ["rounded-corners", "gray-on-gray", "raw-hex-in-components", "emoji-icons", "stock-shadcn-without-pixel-override", "hover-only-interactions"]
}
